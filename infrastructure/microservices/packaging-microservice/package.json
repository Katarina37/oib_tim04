{
  "name": "packaging-microservice",
  "version": "1.0.0",
  "description": "Mikroservis zaduzen za pakovanje parfema i pripremu ambalaze za skladiste",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "if exist dist rmdir /s /q dist && npx tsc",
    "test": "npm run build && node --test dist/Application/usecases/__tests__/*.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
